#!/bin/bash
# Launch SAP MII Workbench on macOS via OpenWebStart.
# Usage: mii-workbench [path/to/Workbench.jsp]   (default: ~/Downloads/Workbench.jsp)
#
# Works around two problems:
#  1. OpenWebStart 1.14 links against sun.awt.AppContext, which JDK 16+ blocks
#     -> run OWS itself on a Java 8 JVM.
#  2. MII's extension JNLPs declare codebase WITHOUT a trailing slash, and
#     IcedTea-Web then drops the :50000 port and fetches jars from :80.
#     -> fetch those extension JNLPs, add the trailing slash, use local copies.
set -euo pipefail

# Show why a launch failed. A double-click runs this script in the background, so without
# an alert the Workbench just never appears. From a terminal the message is enough.
fail() {
    echo "ERROR: $1" >&2
    if [ ! -t 2 ]; then
        osascript - "$1" >/dev/null 2>&1 <<'AS' || true
on run argv
    display alert "MII Workbench did not start" message (item 1 of argv) as critical
end run
AS
    fi
    exit 1
}
trap 'fail "Unexpected error (line $LINENO). Details: ~/Library/Logs/mii-workbench.log"' ERR

SRC="${1:-$HOME/Downloads/Workbench.jsp}"
# JVM that runs OpenWebStart itself. Pick with ~/.config/mii-workbench/java
# (one word: zulu8 | sapmachine11) or MII_JAVA=...; default zulu8.
#   zulu8        native Apple Silicon Java 8   (brew install --cask zulu@8)
#   sapmachine11 native Apple Silicon Java 11  (brew install --cask sap/sapmachine/sapmachine11-jdk)
# Java 16+ cannot work (OWS crash above); Java 24+ removed the SecurityManager.
JVMS=/Library/Java/JavaVirtualMachines
CHOICE="${MII_JAVA:-$(cat "$HOME/.config/mii-workbench/java" 2>/dev/null || echo zulu8)}"
case "$CHOICE" in
    sapmachine11) OWS_JVM="$JVMS/sapmachine-11.jdk/Contents/Home/bin/java" ;;
    *)            OWS_JVM="$JVMS/zulu-8.jdk/Contents/Home/bin/java" ;;
esac
# fall back to Zulu 8 if the chosen JVM is not installed
[ -x "$OWS_JVM" ] || OWS_JVM="$JVMS/zulu-8.jdk/Contents/Home/bin/java"
echo "Using Java: $OWS_JVM"
# generated files: regenerated on every launch, kept out of ~/Downloads
CACHE="$HOME/Library/Caches/mii-workbench"
EXTDIR="$CACHE/mii-ext"
OUT="$CACHE/Workbench-fixed.jnlp"

[ -f "$SRC" ]      || fail "No Workbench.jsp at $SRC. Download a fresh one from MII first."
[ -x "$OWS_JVM" ]  || fail "Java 8 is missing ($OWS_JVM). Run install.sh from the kit again."
[ -f /Applications/OpenWebStart/openwebstart.jar ] || fail "OpenWebStart is missing. Run install.sh from the kit again."
grep -q '<jnlp' "$SRC" || fail "$(basename "$SRC") is not a Workbench launcher (no <jnlp> inside). Download it again from the MII menu."

# Disk guard. The jar cache grows with every MII server and Workbench update; past
# MII_CACHE_MAX_MB (default 500) clear it, and OWS re-downloads what it needs. Skipped
# while a Workbench is running, since it reads jars from that cache.
JAR_CACHE="$HOME/.cache/icedtea-web/cache"
if [ -d "$JAR_CACHE" ] && ! pgrep -f 'icedtea-web/jvm-cache/.*/bin/java' >/dev/null; then
    used_mb=$(( $(du -sk "$JAR_CACHE" | cut -f1) / 1024 ))
    if [ "$used_mb" -gt "${MII_CACHE_MAX_MB:-500}" ]; then
        rm -rf "$JAR_CACHE"
        echo "  cleared jar cache (${used_mb} MB > ${MII_CACHE_MAX_MB:-500} MB): first start downloads again"
    fi
fi
# OWS keeps every Java it downloads under jvm-cache (~360 MB each); only report it
# (on a fresh Mac jvm-cache does not exist yet: find fails, which must not stop the launch)
JVMS_CACHED=$( { find "$HOME/.cache/icedtea-web/jvm-cache" -mindepth 1 -maxdepth 1 -type d 2>/dev/null || true; } | wc -l | tr -d ' ')
[ "${JVMS_CACHED:-0}" -gt 1 ] && echo "  note: $JVMS_CACHED JVMs in ~/.cache/icedtea-web/jvm-cache, remove old ones via 'OpenWebStart Settings'"

mkdir -p "$CACHE"
ERRFILE="$CACHE/last-error.txt"
rm -f "$ERRFILE"
if ! python3 - "$SRC" "$EXTDIR" "$OUT" "$ERRFILE" <<'PY'
import re, os, sys, urllib.request, urllib.error, urllib.parse
src_path, extdir, out_path, err_path = sys.argv[1:5]

def die(msg):
    open(err_path, "w", encoding="utf-8").write(msg)
    sys.exit(3)

def fetch(href):
    host = urllib.parse.urlsplit(href).netloc
    try:
        with urllib.request.urlopen(href, timeout=30) as r:
            return r.read().decode("utf-8")
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            die("The MII server %s refused the request (HTTP %d): the logon ticket in this "
                "Workbench.jsp has probably expired. Download a fresh one from MII." % (host, e.code))
        die("The MII server %s answered HTTP %d for %s." % (host, e.code, href.rsplit("/", 1)[-1]))
    except (urllib.error.URLError, OSError) as e:
        die("Cannot reach the MII server %s. Are you on the company network or VPN? (%s)"
            % (host, getattr(e, "reason", e)))

src = open(src_path, encoding="utf-8").read()
os.makedirs(extdir, exist_ok=True)

hrefs = re.findall(r'<extension\b[^>]*href="([^"]+)"', src)
seen = {}
for href in hrefs:
    name = href.rsplit("/", 1)[-1]
    if name in seen:
        continue
    text = fetch(href)
    if "<jnlp" not in text:
        die("The MII server sent a page instead of %s, which usually means the logon "
            "ticket has expired. Download a fresh Workbench.jsp from MII." % name)
    # the actual bug: codebase without trailing slash loses the port
    text = re.sub(r'codebase="(http://[^"]*?)/?"', lambda m: 'codebase="%s/"' % m.group(1), text)
    open(os.path.join(extdir, name), "w", encoding="utf-8").write(text)
    seen[name] = True
    print("  patched", name)

def repoint(m):
    name = m.group(1).rsplit("/", 1)[-1]
    return m.group(0).replace(m.group(1), "file://" + extdir + "/" + name) if name in seen else m.group(0)

open(out_path, "w", encoding="utf-8").write(
    re.sub(r'<extension\b[^>]*href="([^"]+)"[^>]*/>', repoint, src))
print("  wrote", out_path)
PY
then
    fail "$(cat "$ERRFILE" 2>/dev/null || echo "Preparing the Workbench launch failed. Details: ~/Library/Logs/mii-workbench.log")"
fi

# The patched copy in $CACHE is all OWS needs, so remove the download: it holds a logon
# ticket and session cookies. Older Workbench*.jsp downloads go too (their tickets expire).
# Set MII_KEEP_JSP=1 to keep them.
if [ "${MII_KEEP_JSP:-0}" != 1 ]; then
    rm -f -- "$SRC"
    find "$HOME/Downloads" -maxdepth 1 -type f -name 'Workbench*.jsp' -delete 2>/dev/null || true
    echo "  removed $SRC"
fi

echo "Launching Workbench (a security dialog will appear — accept it)..."
# Java 9+ only: open the internal AWT classes OWS uses (Java 8 rejects these flags)
JFLAGS=()
"$OWS_JVM" -version 2>&1 | grep -q '"1\.8' || JFLAGS=(--add-exports=java.desktop/sun.awt=ALL-UNNAMED
    --add-opens=java.desktop/sun.awt=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED)
# Right-click fix: Workbench opens its tree context menu only on a *released* popup
# trigger (Windows behaviour); macOS flags the *press*. This agent moves the flag.
# JAVA_TOOL_OPTIONS is inherited by the Workbench JVM that OWS spawns.
# Source: ~/.config/mii-workbench/PopupTriggerFix.java
POPUP_FIX="$HOME/.config/mii-workbench/mac-popup-fix.jar"
# The agent also names the Workbench JVM "MII Workbench" in the Dock and sets this icon.
DOCK_ICON=/Applications/OpenWebStart/Icon-512.png
[ -f "$POPUP_FIX" ] && export JAVA_TOOL_OPTIONS="-javaagent:$POPUP_FIX=$DOCK_ICON${JAVA_TOOL_OPTIONS:+ $JAVA_TOOL_OPTIONS}"
# This launcher JVM only waits for the Workbench JVM: keep it out of the Dock.
exec "$OWS_JVM" -Dapple.awt.UIElement=true ${JFLAGS[@]+"${JFLAGS[@]}"} -cp /Applications/OpenWebStart/openwebstart.jar \
    com.openwebstart.launcher.PhaseTwoWebStartLauncher "$OUT"
